{
  "name": "verge-monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "lint": "npm --prefix client run lint && npm --prefix server run lint",
    "lint:client": "npm --prefix client run lint",
    "lint:server": "npm --prefix server run lint",
    "test": "npm --prefix server test",
    "test:confidence": "npm --prefix server run test:confidence",
    "test:media": "npm --prefix server run test:media",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev"
  }
}
